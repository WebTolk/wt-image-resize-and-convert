<?xml version="1.0" encoding="UTF-8"?>
<extension type="plugin" group="media-action" method="upgrade">
    <name>plg_media-action_wtimageresizeconvert</name>
    <author>WebTolk</author>
    <creationDate>04.09.2026</creationDate>
    <copyright>Copyright (c) 2026 WebTolk. All rights reserved.</copyright>
    <license>GNU General Public License version 3 or later.</license>
    <authorEmail>info@web-tolk.ru</authorEmail>
    <authorUrl>https://web-tolk.ru</authorUrl>
    <version>1.0.0</version>
    <description>PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_DESC</description>
    <namespace path="src">Webtolk\Plugin\MediaAction\WtImageResizeConvert</namespace>
    <scriptfile>script.php</scriptfile>
    <files>
        <filename>script.php</filename>
        <folder plugin="wtimageresizeconvert">services</folder>
        <folder>forms</folder>
        <folder>language</folder>
        <folder>src</folder>
    </files>
    <languages>
        <language tag="en-GB">language/en-GB/plg_media-action_wtimageresizeconvert.ini</language>
        <language tag="en-GB">language/en-GB/plg_media-action_wtimageresizeconvert.sys.ini</language>
        <language tag="ru-RU">language/ru-RU/plg_media-action_wtimageresizeconvert.ini</language>
        <language tag="ru-RU">language/ru-RU/plg_media-action_wtimageresizeconvert.sys.ini</language>
    </languages>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field
                        addfieldprefix="Webtolk\Plugin\MediaAction\WtImageResizeConvert\Field"
                        name="plugininfo"
                        type="plugininfo"
                        label="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_INFO_LABEL"
                        description="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_INFO_DESC"
                />
                <field
                        name="enabled"
                        type="radio"
                        label="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_ENABLED_LABEL"
                        description="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_ENABLED_DESC"
                        layout="joomla.form.field.radio.switcher"
                        default="1"
                        filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                        name="processor_backend"
                        type="list"
                        label="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_PROCESSOR_BACKEND_LABEL"
                        description="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_PROCESSOR_BACKEND_DESC"
                        default="joomla-core"
                        validate="options"
                >
                    <option value="joomla-core">PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_PROCESSOR_BACKEND_JOOMLA_CORE
                    </option>
                </field>
                <field
                        name="resize_mode"
                        type="list"
                        label="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_RESIZE_MODE_LABEL"
                        description="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_RESIZE_MODE_DESC"
                        default="none"
                        validate="options"
                >
                    <option value="none">PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_RESIZE_MODE_NONE</option>
                    <option value="fit">PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_RESIZE_MODE_FIT</option>
                    <option value="crop">PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_RESIZE_MODE_CROP</option>
                    <option value="width">PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_RESIZE_MODE_WIDTH</option>
                    <option value="height">PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_RESIZE_MODE_HEIGHT</option>
                </field>
                <field
                        name="max_width"
                        type="number"
                        label="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_MAX_WIDTH_LABEL"
                        description="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_MAX_WIDTH_DESC"
                        default="1920"
                        min="0"
                        step="1"
                        addonAfter="px"
                        filter="integer"
                        showon="resize_mode!:none"
                />
                <field
                        name="max_height"
                        type="number"
                        label="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_MAX_HEIGHT_LABEL"
                        description="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_MAX_HEIGHT_DESC"
                        default="1080"
                        min="0"
                        step="1"
                        addonAfter="px"
                        filter="integer"
                        showon="resize_mode!:none"
                />
                <field
                        name="image_fill_color"
                        type="color"
                        label="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_IMAGE_FILL_COLOR_LABEL"
                        description="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_IMAGE_FILL_COLOR_DESC"
                        default="#ffffff"
                        filter="color"
                        showon="resize_mode:fit"
                />
                <field
                        name="allow_upscale"
                        type="radio"
                        label="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_ALLOW_UPSCALE_LABEL"
                        description="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_ALLOW_UPSCALE_DESC"
                        layout="joomla.form.field.radio.switcher"
                        default="0"
                        filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                        name="output_format"
                        type="list"
                        label="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_OUTPUT_FORMAT_LABEL"
                        description="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_OUTPUT_FORMAT_DESC"
                        default="keep"
                        validate="options"
                >
                    <option value="keep">PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_FORMAT_KEEP</option>
                    <option value="jpg">JPG</option>
                    <option value="png">PNG</option>
                    <option value="gif">GIF</option>
                    <option value="webp">WEBP</option>
                    <option value="avif">AVIF</option>
                </field>
                <field
                        name="quality"
                        type="number"
                        label="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_QUALITY_LABEL"
                        description="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_QUALITY_DESC"
                        default="82"
                        min="1"
                        max="100"
                        step="1"
                        filter="integer"
                />
                <field
                        name="png_compression"
                        type="number"
                        label="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_PNG_COMPRESSION_LABEL"
                        description="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_PNG_COMPRESSION_DESC"
                        default="6"
                        min="0"
                        max="9"
                        step="1"
                        filter="integer"
                        showon="output_format:png"
                />
                <field
                        name="strict_mode"
                        type="radio"
                        label="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_STRICT_MODE_LABEL"
                        description="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_STRICT_MODE_DESC"
                        layout="joomla.form.field.radio.switcher"
                        default="0"
                        filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
            </fieldset>
            <fieldset name="watermark" label="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_FIELDSET_WATERMARK">
                <field
                        name="watermark_enabled"
                        type="radio"
                        label="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_WATERMARK_ENABLED_LABEL"
                        description="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_WATERMARK_ENABLED_DESC"
                        layout="joomla.form.field.radio.switcher"
                        default="0"
                        filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                        name="watermark_path"
                        type="media"
                        label="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_WATERMARK_PATH_LABEL"
                        description="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_WATERMARK_PATH_DESC"
                        default=""
                        types="images"
                        filter="string"
                />
                <field
                        name="watermark_position"
                        type="list"
                        label="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_WATERMARK_POSITION_LABEL"
                        description="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_WATERMARK_POSITION_DESC"
                        default="bottom-right"
                        validate="options"
                >
                    <option value="top-left">PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_POSITION_TOP_LEFT</option>
                    <option value="top-right">PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_POSITION_TOP_RIGHT</option>
                    <option value="center">PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_POSITION_CENTER</option>
                    <option value="bottom-left">PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_POSITION_BOTTOM_LEFT</option>
                    <option value="bottom-right">PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_POSITION_BOTTOM_RIGHT</option>
                </field>
                <field
                        name="watermark_opacity"
                        type="number"
                        label="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_WATERMARK_OPACITY_LABEL"
                        description="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_WATERMARK_OPACITY_DESC"
                        default="80"
                        min="1"
                        max="100"
                        step="1"
                        filter="integer"
                />
                <field
                        name="watermark_scale"
                        type="number"
                        label="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_WATERMARK_SCALE_LABEL"
                        description="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_WATERMARK_SCALE_DESC"
                        default="20"
                        min="1"
                        max="100"
                        step="1"
                        addonAfter="%"
                        filter="integer"
                />
                <field
                        name="watermark_margin_x"
                        type="number"
                        label="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_WATERMARK_MARGIN_X_LABEL"
                        description="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_WATERMARK_MARGIN_X_DESC"
                        default="24"
                        min="0"
                        step="1"
                        addonAfter="px"
                        filter="integer"
                />
                <field
                        name="watermark_margin_y"
                        type="number"
                        label="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_WATERMARK_MARGIN_Y_LABEL"
                        description="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_WATERMARK_MARGIN_Y_DESC"
                        default="24"
                        min="0"
                        step="1"
                        addonAfter="px"
                        filter="integer"
                />
            </fieldset>
            <fieldset name="processing_profiles" label="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_FIELDSET_PROCESSING_PROFILES">
                <field
                        name="processing_profiles"
                        type="subform"
                        label="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_PROCESSING_PROFILES_LABEL"
                        description="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_PROCESSING_PROFILES_DESC"
                        multiple="true"
                        formsource="plugins/media-action/wtimageresizeconvert/forms/processing_profile.xml"
                        layout="joomla.form.field.subform.repeatable"
                />
            </fieldset>
            <fieldset name="folder_rules" label="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_FIELDSET_FOLDER_RULES">
                <field
                        name="folder_rules"
                        type="subform"
                        label="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_FOLDER_RULES_LABEL"
                        description="PLG_MEDIA-ACTION_WTIMAGERESIZECONVERT_FOLDER_RULES_DESC"
                        multiple="true"
                        formsource="plugins/media-action/wtimageresizeconvert/forms/folder_rule.xml"
                        layout="joomla.form.field.subform.repeatable-table"
                />
            </fieldset>
        </fields>
    </config>
    <updateservers>
        <server type="extension" name="WT Image Resize and Convert">https://web-tolk.ru/component/swjprojects/jupdate?element=wtimageresizeconvert</server>
    </updateservers>
    <changelogurl>https://web-tolk.ru/jchangelog?element=wtimageresizeconvert</changelogurl>
</extension>
